#! /usr/bin/env python3

import argparse
import os
import pathlib
import shutil
import subprocess
import sys

from debian_common import (
    APT_PACKAGES,
    install_dependencies,
    replace_python_package,
    user_paths,
    validate_python_sources,
    verify_dependencies,
)


def parse_args():
    parser = argparse.ArgumentParser(prog="debian-user-install")
    parser.add_argument(
        "-i",
        "--install-packages",
        dest="packages",
        action="store_true",
        help="install all runtime dependencies system-wide with apt-get",
    )
    parser.add_argument(
        "-p",
        "--proxy",
        help="specify a proxy host that is always used for connections",
    )
    parser.add_argument(
        "clone_url", help="Git clone URL used to load the SSH configuration"
    )
    return parser.parse_args()


def dependency_preflight(install_packages):
    if install_packages:
        use_sudo = os.geteuid() != 0
        if use_sudo and shutil.which("sudo") is None:
            print(
                "Administrator action required: run `apt-get install "
                + " ".join(APT_PACKAGES)
                + "` as root, then rerun this installer without -i.",
                file=sys.stderr,
            )
            sys.exit(1)
        print("Installing Debian dependencies: " + " ".join(APT_PACKAGES))
        install_dependencies(use_sudo=use_sudo)

    missing = verify_dependencies()
    if missing:
        print(
            "The following Debian packages are missing: " + " ".join(missing),
            file=sys.stderr,
        )
        print(
            "Ask an administrator to run `apt-get install "
            + " ".join(missing)
            + "`, or rerun this installer with -i if sudo is available.",
            file=sys.stderr,
        )
        sys.exit(1)


def write_pull_wrapper(path):
    print("Creating pull wrapper " + str(path) + " ...")
    os.makedirs(path.parent, exist_ok=True)
    with open(path, "w") as file:
        file.write("""#! /bin/bash

cd "$(dirname "$0")"/../host_repo || exit 1
pull_output="$(git pull 2>&1)"
pull_exit="$?"
if [ "$pull_exit" != "0" ]; then
  echo "$pull_output"
  echo "Fatal, could not update the lssh configuration because git pull failed" 1>&2
  exit 1
fi
"$HOME"/.lssh/bin/lssh --load-from .
""")
    os.chmod(path, 0o755)


def write_launcher(path, proxy):
    print("Creating lssh executable in " + str(path) + " ...")
    if proxy is not None:
        main_call = """options = {
    "general_proxy": """ + repr(proxy) + """,
}
main.main(hosts_dir, update_hosts, attributes=options)
"""
    else:
        main_call = "main.main(hosts_dir, update_hosts)\n"

    with open(path, "w") as file:
        file.write("""#! /usr/bin/env python3

import subprocess
import sys
from pathlib import Path

lssh_home = Path.home() / ".lssh"
hosts_dir = str(lssh_home / "hosts")

def update_hosts():
    subprocess.run([str(lssh_home / "bin" / "pull.sh")], check=True)

sys.path.insert(0, str(lssh_home / "lib"))

from lssh import main
""" + main_call)
    os.chmod(path, 0o755)


def add_bash_completion(path):
    instruction = "complete -o filenames -C 'lssh __complete__' lssh"
    current = path.read_text() if path.exists() else ""
    if instruction not in current.splitlines():
        print("Writing bash completion instructions to " + str(path) + " ...")
        with open(path, "a") as file:
            if current and not current.endswith("\n"):
                file.write("\n")
            file.write(instruction + "\n")


def main():
    args = parse_args()
    base_dir = pathlib.Path(os.path.realpath(__file__)).parent.parent
    source = base_dir / "lssh"

    try:
        validate_python_sources(source)
        dependency_preflight(args.packages)
    except (OSError, RuntimeError, subprocess.CalledProcessError, SyntaxError) as error:
        print("Preflight failed: " + str(error), file=sys.stderr)
        return 1

    paths = user_paths()
    print("Copying source files to " + str(paths.library) + " ...")
    replace_python_package(source, paths.library)

    repo_clone_needed = not (paths.repository / ".git").is_dir()
    if repo_clone_needed:
        print("Cloning repository into " + str(paths.repository) + " ...")
        os.makedirs(paths.repository, mode=0o700, exist_ok=True)
        try:
            subprocess.run(
                ["git", "clone", args.clone_url, str(paths.repository)], check=True
            )
        except subprocess.CalledProcessError as error:
            print("Could not clone the host repository: " + str(error), file=sys.stderr)
            return 1
    else:
        print("Repository in " + str(paths.repository) + " already exists.")

    print("Creating directory for validated hosts in " + str(paths.hosts) + " ...")
    os.makedirs(paths.hosts, exist_ok=True)
    write_pull_wrapper(paths.pull_wrapper)
    write_launcher(paths.launcher, args.proxy)

    print("Creating config file " + str(paths.whitelist) + " ...")
    if paths.whitelist.is_file():
        print("  (did already exist)")
    else:
        os.makedirs(paths.whitelist.parent, exist_ok=True)
        paths.whitelist.touch()

    add_bash_completion(paths.completion)

    if repo_clone_needed:
        print("Loading initial hostlist ...")
        try:
            subprocess.run(
                [str(paths.launcher), "--load-from", str(paths.repository)],
                check=True,
            )
        except subprocess.CalledProcessError:
            print(
                "The SSH configuration was not loaded because validation failed.",
                file=sys.stderr,
            )
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
